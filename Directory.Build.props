<Project>

  <!-- Weblitz's samples (the WeblitzPdf package, as an application of yours references it: from NuGet.org). Their shared
       settings: one .NET, one WeblitzPdf version to move with each release. This file and Directory.Build.targets also
       keep the samples apart from any repository they are copied into. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WeblitzPdfVersion>2.0.0-beta.9</WeblitzPdfVersion>
    <!-- The package carries the script engine for every platform: built for the machine's own (or the one you publish
         for, dotnet publish -r linux-x64), an application takes one, about a ninth of it. SamplesPortable=true builds for
         all of them. (The SDK names its own platform only after this file is read: the machine's is worked out here;
         on Alpine pass -r linux-musl-x64.) -->
    <_SamplesOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_SamplesOs>
    <_SamplesOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_SamplesOs>
    <_SamplesOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_SamplesOs>
    <_SamplesArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_SamplesArch>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(SamplesPortable)' != 'true' and '$(_SamplesOs)' != ''">$(_SamplesOs)-$(_SamplesArch)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
